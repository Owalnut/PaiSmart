<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yizhaoqi.smartpai.mapper.DocumentVectorMapper">

    <select id="selectByFileMd5" resultType="com.yizhaoqi.smartpai.model.DocumentVector">
        SELECT * FROM document_vectors WHERE file_md5 = #{fileMd5}
    </select>

    <delete id="deleteByFileMd5">
        DELETE FROM document_vectors WHERE file_md5 = #{fileMd5}
    </delete>
</mapper>
