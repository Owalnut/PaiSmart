<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yizhaoqi.smartpai.mapper.ConversationMapper">

    <select id="selectByUserIdAndTimestampBetween" resultType="com.yizhaoqi.smartpai.model.Conversation">
        SELECT * FROM conversations
        WHERE user_id = #{userId} AND timestamp BETWEEN #{start} AND #{end}
    </select>

    <select id="selectByUserId" resultType="com.yizhaoqi.smartpai.model.Conversation">
        SELECT * FROM conversations WHERE user_id = #{userId}
    </select>

    <select id="selectByTimestampBetween" resultType="com.yizhaoqi.smartpai.model.Conversation">
        SELECT * FROM conversations WHERE timestamp BETWEEN #{start} AND #{end}
    </select>
</mapper>
