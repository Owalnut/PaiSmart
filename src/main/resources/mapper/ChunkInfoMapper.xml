<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yizhaoqi.smartpai.mapper.ChunkInfoMapper">

    <select id="selectByFileMd5OrderByChunkIndexAsc" resultType="com.yizhaoqi.smartpai.model.ChunkInfo">
        SELECT * FROM chunk_info WHERE file_md5 = #{fileMd5} ORDER BY chunk_index ASC
    </select>
</mapper>
